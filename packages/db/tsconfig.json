{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "generated/**/*.ts",
    "prisma7.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
